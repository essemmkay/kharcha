# Copy to mobile/.env and fill in. Expo exposes EXPO_PUBLIC_* to the app bundle.
# Reuse the same Supabase project the Next.js API uses.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Base URL of the deployed headless Next.js API (no trailing slash).
EXPO_PUBLIC_API_URL=https://kharchadeploy.vercel.app
